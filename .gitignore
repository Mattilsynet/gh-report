# Build artifacts
target/
**/target/

# macOS
.DS_Store

# IDE
.vscode/
*.swp
*.swo

# OODA scratch artefacts (keep dir, ignore contents)
.ooda/*
!.ooda/.gitkeep

# graphify knowledge graph output (per-developer; rebuildable via
# `graphify extract .` or the `graphify hook install` post-commit hook).
graphify-out/

# adr-srv runtime event store (per-developer; rebuildable from corpus)
.adr-srv/

# gh-report runtime event store (per-developer; rebuildable from GitHub API)
.ghr-store/

# LLM scratch notes (pre-research drafts, not intentional docs)
docs/notes/

# Memory-profiling outputs (per-run scratch from dhat / RSS sampling;
# rebuildable, not intentional artefacts).
dhat-heap.json
**/dhat-heap.json
rss.csv
**/rss.csv

# Beads / Dolt files (added by bd init)
.dolt/

# Beads issues export — internal planning history, not for public history.
# bd regenerates this file from the Dolt store; ignoring it keeps it local.
.beads/issues.jsonl
.beads/events.jsonl

# Bead-db rollback backups (local artefacts; keep out of git)
.beads.backup-*

# bd runtime artefacts regenerated on demand (workspace gate lock, and the
# auto-import dedup marker keyed to .beads/issues.jsonl). Never source.
.beads.gate.lock
.beads/.auto-import-issues.jsonl

# opencode plugin deps
.opencode/node_modules/
*.db
.beads-credential-key

# gh-report runtime storage (--store-dir default is "store"); also catch
# any per-crate runs that materialise a nested store/ tree.
store/
**/store/
# Source-module exception: the pardosa crate has a legitimate src/store/
# directory. Negate so the broader **/store/ rule above does not silently
# hide its contents from git/CI. Add further negations here if other crates
# introduce a src/store/ source module.
!crates/pardosa/src/store/
!crates/pardosa/src/store/**
!crates/gh-report/src/store/
!crates/gh-report/src/store/**

# gh-report web-client generated TypeScript bindings (regenerated by the
# build; not intentional source).
crates/gh-report/templates/*.d.ts

# Bespoke scripts. The Track-4 experiment (prod-loc, track4-verify, awk
# loc/adr counters, citation-diff) was retracted 2026-05-16 — drift +
# clutter cost exceeded the value delivered (most criteria already
# enforced by `cargo test` / `cargo clippy` / `cargo fmt` CI jobs).
# Keep this directory ignored so future throwaway tooling does not
# silently accumulate in git history. Promote any genuinely durable
# tool to its own crate under `crates/` with an ADR justifying it.
scripts/

# FizzBee model-checker output — graph dotfiles + compiled AST JSON.
# Regenerated by `fizz spec/fizzbee/<name>.fizz`; not source, not
# durable evidence (fizz counterexample output is captured instead in
# spec/fizzbee/README.md).
spec/fizzbee/out/
out/
spec/fizzbee/*.json

# Out-of-workspace WASM guest scratch (not a workspace member, no manifest).
# Holds generated bindings plus a cargo target tree; keep it local rather
# than deleting it, since it is not rebuildable from anything in this repo.
guests/


# insta pending snapshots
*.snap.new
